{
  "name": "thrifthub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --hostname 192.168.56.1 --port 3000 --experimental-https --experimental-https-key certs/thrifthub-key.pem --experimental-https-cert certs/thrifthub-cert.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "staff:reset-password": "node --env-file=.env.local --import tsx scripts/reset-staff-password.ts",
    "orders:expire": "tsx scripts/expire-public-orders.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
